# Copy this file to ".env" for local development, or set these as
# environment variables in the Render dashboard for production.
# NEVER commit a real .env file — it's gitignored.

# Secret used to sign the login session cookie. Must be long and random.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. If DATABASE_URL is set, the app uses PostgreSQL (this is what
# Render injects automatically when you attach a Postgres instance). Leave it
# unset locally to fall back to a SQLite file at CIRCUIT_DB.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
CIRCUIT_DB=circuit.db

# The admin account seeded on first run (only used if no users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Account recovery (locked out / forgot the admin password):
# set ADMIN_RESET=1 together with ADMIN_USERNAME/ADMIN_PASSWORD, restart, then
# log in with those credentials. REMOVE ADMIN_RESET afterwards so the password
# isn't reset on every restart.
# ADMIN_RESET=1

# Set to 1 in production so the session cookie is only sent over HTTPS.
SECURE_COOKIES=0

# Local dev server only (Render sets PORT for you).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
